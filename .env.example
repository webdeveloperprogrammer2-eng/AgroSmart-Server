# Server
NODE_ENV=development
# Фронтенд ба http://localhost:8000 муроҷиат мекунад (src/api/config.js)
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/agrosmart
PGSSL=false

# Суратҳо ҳамчун base64 меоянд — маҳдудияти ҷисми дархост
JSON_LIMIT=15mb

# CORS: "*" барои ҳама, ё бо вергул: http://localhost:5173
CORS_ORIGIN=*
