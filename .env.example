# ============================================================
# AgroSmart API — намуна. Нусха гиред: cp .env.example .env
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=8000

# ---------- Database ----------
# Render (external): аз Render → Database → Connections → External Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST.oregon-postgres.render.com:5432/DBNAME
# Postgres маҳаллӣ:
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/agrosmart

# Render → true, localhost → false
PGSSL=true

# ---------- App ----------
# Суратҳо ҳамчун base64 меоянд — маҳдудияти ҷисми дархост
JSON_LIMIT=15mb

# CORS: "*" барои ҳама, ё бо вергул: http://localhost:5173
CORS_ORIGIN=*
