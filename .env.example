# ============================================================
# AgroSmart API — намуна. Нусха гиред: cp .env.example .env
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=8000

# ---------- Database ----------
# Render (external): аз Render → Database → Connections → External Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST.oregon-postgres.render.com:5432/DBNAME
# Postgres маҳаллӣ:
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/agrosmart

# Render → true, localhost → false
PGSSL=true

# ---------- App ----------
# Суратҳо ҳамчун base64 меоянд — маҳдудияти ҷисми дархост
JSON_LIMIT=15mb

# CORS: "*" барои ҳама, ё бо вергул: http://localhost:5173
CORS_ORIGIN=*

# Бефаъолиятӣ: агар ин қадар соат ягон дархост наояд, сервер хомӯш мешавад.
# 0 = ҳеҷ гоҳ худаш хомӯш нашавад.
IDLE_SHUTDOWN_HOURS=24

# Keep-alive: сервер ҳар ин қадар дақиқа худашро ping мекунад, то Render-и
# ройгон онро хоб накунад. Суроға дар Render худкор (RENDER_EXTERNAL_URL).
KEEP_ALIVE_MINUTES=10
# KEEP_ALIVE_URL=https://agrosmart-server.onrender.com
